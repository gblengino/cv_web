---
import { Icon } from "astro-icon/components"

const {label, icon, href} = Astro.props
const path = Astro.url.pathname
const isActive = href === "/" ? path === "/" : path.startsWith(href)
---

<a href={href} class={`flex-1 w-full px-8 py-2 flex gap-2 text-zinc-100 ${isActive ? "bg-zinc-900 text-white" :
"hover:bg-zinc-700 hover:text-cyan-500 hover:underline transition-colors duration-200"}`}>
    <Icon name={icon} class:list={'text-3xl'}/>
    <span class="text-xl content-end font-light">{label}</span>
</a>